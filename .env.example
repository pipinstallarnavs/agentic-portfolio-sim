# Copy this file to .env and fill in values. Never commit the real .env.

# --- Optional LLM extension; base learning demo stays offline ---
# Which provider to use: "mock" (default, no API calls) or "anthropic"
LLM_PROVIDER=mock

# Required only if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Set an exact model ID available on your own API account
LLM_MODEL=

# --- Data provider ---
# "yfinance" downloads + caches locally; "local" reads only from data/raw cache
DATA_PROVIDER=yfinance
